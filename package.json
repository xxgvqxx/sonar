{
  "name": "sonar",
  "version": "0.1.0",
  "description": "Local hub that lets Claude Code and Codex CLI sessions share context and chat across terminals/branches over a single MCP server.",
  "type": "module",
  "bin": {
    "sonar": "bin/sonar.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "daemon": "node --disable-warning=ExperimentalWarning src/cli.ts daemon",
    "start": "node --disable-warning=ExperimentalWarning src/cli.ts start",
    "stop": "node --disable-warning=ExperimentalWarning src/cli.ts stop",
    "status": "node --disable-warning=ExperimentalWarning src/cli.ts status",
    "install:clients": "node --disable-warning=ExperimentalWarning src/cli.ts install",
    "test:e2e": "node --disable-warning=ExperimentalWarning test/e2e.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.2",
    "zod": "^3.23.8"
  }
}
